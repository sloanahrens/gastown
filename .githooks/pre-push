#!/bin/bash
# Block PRs by preventing pushes to arbitrary feature branches.
# Gas Town agents push to main (crew) or polecat/* branches (polecats).
# PRs are for external contributors only.
#
# Also enforces integration branch landing guardrails: pushes to the default
# branch that introduce integration branch content are blocked unless
# GT_INTEGRATION_LAND=1 is set (only gt mq integration land sets this).
#
# Also refuses pushes to the default branch from a polecat (gt-ibt8). The
# branch allowlist below predates the role check and lets the default branch
# through for every caller ("crew workers push here directly"), so nothing
# stopped a polecat from landing work on main past the MR, the Refinery gates,
# and the om review: granite pushed origin/main -> c2120a9 that way on
# 09-17 12:08 (HEAD:main from a detached HEAD). Polecat work lands through
# `gt done` -> MR -> Refinery. See is_polecat_caller and the check in the
# loop below for the two deliberate pushers that must still get through.

# Detect the rig's default branch dynamically.
# Fallback chain matches Go implementation (git.RemoteDefaultBranch):
# 1. origin/HEAD symref
# 2. origin/master (if it exists)
# 3. origin/main (final fallback)
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##')
if [[ -z "$default_branch" ]]; then
  if git rev-parse --verify origin/master &>/dev/null; then
    default_branch=master
  else
    default_branch=main
  fi
fi

# Allowed patterns:
#   <default_branch>, beads-sync  - Direct work branches
#   polecat/*                     - Polecat working branches (Refinery merges these)
#   integration/*                 - Integration branches (created by gt mq integration)

# is_polecat_caller reports whether the process running this hook belongs to a
# polecat, as opposed to crew / refinery / mayor / witness / any non-agent
# caller. Two independent signals, either one is enough:
#
#   GT_ROLE - set by the session manager at spawn: "polecat", or the compound
#             form "<rig>/polecats/<name>".
#   $PWD    - for a polecat push the hook runs inside the polecat's own
#             worktree, <town>/<rig>/polecats/<name>/<repo>.
#
# GT_POLECAT is deliberately NOT a signal: coordinators can carry a stale
# GT_POLECAT in their environment (sling treats GT_ROLE as the authoritative
# polecat check for exactly that reason), and a false positive here would
# refuse the Refinery's own merge or a crew member's legitimate push.
is_polecat_caller() {
  case "${GT_ROLE:-}" in
    polecat|*/polecats/*) return 0 ;;
  esac
  case "${PWD:-}" in
    */polecats/*) return 0 ;;
  esac
  return 1
}

# is_polecat_main_push_allowed reports whether this particular push to the
# default branch is one of the deliberate, gate-checked pushes a polecat
# session is sanctioned to make. Both signals are set by gt code paths that
# have already decided the push is legitimate - neither is a user override:
#
#   GT_REFINERY_MERGE=1    - the Refinery's merge (internal/refinery/batch.go,
#                            internal/refinery/engineer.go), which owns landing
#                            verified MRs on the default branch.
#   GT_DONE_DIRECT_MERGE=1 - `gt done` landing a convoy whose merge_strategy is
#                            "direct" (internal/cmd/done.go). That strategy
#                            skips the MR on purpose and is itself gated on the
#                            source issue (no_merge, review_only, unchecked
#                            acceptance criteria, merge_strategy=local).
is_polecat_main_push_allowed() {
  [[ "${GT_REFINERY_MERGE:-0}" == "1" ]] && return 0
  [[ "${GT_DONE_DIRECT_MERGE:-0}" == "1" ]] && return 0
  return 1
}

while read local_ref local_sha remote_ref remote_sha; do
  # Skip tags - they're allowed for releases
  if [[ "$remote_ref" == refs/tags/* ]]; then
    continue
  fi

  # Skip notes - they're proof records (e.g. refs/notes/om), not branches, and
  # aren't subject to the branch allowlist below.
  if [[ "$remote_ref" == refs/notes/* ]]; then
    continue
  fi

  branch="${remote_ref#refs/heads/}"

  # Polecat main-push refusal (gt-ibt8). Checked before the off-branch guard
  # below so a polecat's `git push origin main` gets the message that names the
  # real remedy (gt done) rather than the generic HEAD-mismatch one.
  if [[ "$branch" == "$default_branch" ]] && is_polecat_caller && ! is_polecat_main_push_allowed; then
    echo "BLOCKED: polecats never push to '$default_branch'."
    echo ""
    echo "A polecat's work lands through the merge queue, never as a direct push -"
    echo "a direct push to '$default_branch' skips the MR, the Refinery's gate run,"
    echo "and the om review (gt-ibt8: granite pushed origin/$default_branch from a"
    echo "detached HEAD this way on 09-17)."
    echo ""
    echo "  Right:  gt done          # pushes polecat/<name>/<bead> and submits an MR"
    echo "  Wrong:  git push origin HEAD:$default_branch"
    echo ""
    echo "The Refinery merges to $default_branch after verification."
    echo "Detected as a polecat via GT_ROLE=${GT_ROLE:-<unset>} and cwd $PWD."
    echo ""
    echo "If this push is a legitimate landing (Refinery merge, or a gt done"
    echo "direct-merge convoy) it must come from that gt code path, which sets"
    echo "GT_REFINERY_MERGE=1 / GT_DONE_DIRECT_MERGE=1 for this push."
    echo ""
    echo "Two other flows push the default branch and get no env signal here,"
    echo "because a signal an agent sets for itself is a user override, not a"
    echo "gate (gt-deff):"
    echo "  - a release (beads-release 'push-main' / gastown-release 'push-release')"
    echo "  - a plugin script's own push, when an agent runs its instructions"
    echo "      (plugins write both, but the daemon runs them as GT_ROLE=daemon/plugin"
    echo "       and is not a polecat caller - this only bites a manual run)"
    echo "Both belong to a crew, mayor, or refinery session. Run them there."
    exit 1
  fi

  # HEAD-mismatch guard: refuse pushing a branch you are not standing on.
  # `git push origin <B>` pushes the local <B> ref regardless of where HEAD is, so
  # running it from a session/feature branch silently no-ops ("Everything up-to-date")
  # or pushes a stale ref — the work is stranded on a branch nobody merges. Git's
  # conflict model can't catch this: it happens before any divergence exists.
  # Only fires when a local branch ref is being pushed (not HEAD:x, tags, or deletes).
  # Override for intentional cross-branch pushes: GT_ALLOW_OFFBRANCH_PUSH=1
  if [[ "${GT_ALLOW_OFFBRANCH_PUSH:-0}" != "1" \
        && "$local_ref" == refs/heads/* \
        && "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
    head_branch=$(git symbolic-ref --short -q HEAD || echo "")
    pushed_branch="${local_ref#refs/heads/}"
    if [[ -n "$head_branch" && "$head_branch" != "$pushed_branch" ]]; then
      echo "BLOCKED: pushing '$pushed_branch' while HEAD is on '$head_branch'."
      echo ""
      echo "You are not on the branch you are pushing. This commonly no-ops silently"
      echo "(\"Everything up-to-date\") or pushes a stale ref, leaving the real work"
      echo "stranded on a branch nobody merges."
      echo ""
      echo "  Check:  git status -sb ; git reflog | head"
      echo "  Fix:    git switch '$pushed_branch'   (then re-push)"
      echo "  Intentional cross-branch push? re-run with GT_ALLOW_OFFBRANCH_PUSH=1"
      exit 1
    fi
  fi

  case "$branch" in
    "${default_branch}"|beads-sync|polecat/*|integration/*)
      # Allowed branches
      ;;
    *)
      # Allow feature branches when contributing to upstream (fork workflow).
      # If an 'upstream' remote exists, this is a contribution setup where
      # feature branches are needed for PRs. See: #848
      if ! git remote get-url upstream &>/dev/null; then
        echo "ERROR: Invalid branch for Gas Town agents."
        echo ""
        echo "Blocked push to: $branch"
        echo ""
        echo "Allowed branches:"
        echo "  ${default_branch}        - Crew workers push here directly"
        echo "  polecat/*   - Polecat working branches"
        echo "  integration/* - Integration branches"
        echo "  beads-sync  - Beads synchronization"
        echo ""
        echo "Do NOT create PRs. Push to main or let Refinery merge polecat work."
        exit 1
      fi
      ;;
  esac

  # Integration branch landing guardrail: when pushing to the default branch,
  # check if any integration branch tip is newly reachable from this push.
  # This catches merges (--no-ff, --ff-only, default) and rebases.
  # Only cherry-picks (new SHAs) are not detected — Layer 1 covers those.
  if [[ "$branch" == "$default_branch" ]] && [[ "$GT_INTEGRATION_LAND" != "1" ]]; then
    # Skip for deletions or initial pushes
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]] || \
       [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
      continue
    fi
    # Check if any integration branch tip is newly reachable from this push.
    # Use ls-remote instead of for-each-ref to avoid false positives from stale
    # local tracking refs that may linger after branch deletion.
    # Fail closed: if ls-remote fails (network error), block the push rather than
    # silently allowing unverified integration branch content through.
    integration_refs=$(git ls-remote --quiet origin "refs/heads/integration/*" 2>&1) || {
      echo "WARNING: Cannot verify integration branches (remote unreachable)."
      echo "Push to $default_branch blocked. Retry when network is available,"
      echo "or set GT_INTEGRATION_LAND=1 if this is an intentional land operation."
      exit 1
    }
    for ref in $(echo "$integration_refs" | awk '{print $1}'); do
      if git merge-base --is-ancestor "$ref" "$local_sha" && \
         ! git merge-base --is-ancestor "$ref" "$remote_sha"; then
        echo "BLOCKED: Push to $default_branch introduces integration branch content."
        echo ""
        echo "Integration branches must be landed via: gt mq integration land <epic-id>"
        echo ""
        echo "This guardrail prevents accidental landing of integration branches."
        echo "The gt mq integration land command sets GT_INTEGRATION_LAND=1 to bypass this check."
        exit 1
      fi
    done
  fi
done

exit 0
