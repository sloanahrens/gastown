# The bd gateway image gt-bd: the real bd with the gateway bdgw in front of it
# (docs/design/bd-container.md, Architecture).
#
# It builds in one stage on the daemon image's base. The build context holds
# bd.real (the real bd), bdgw (the gateway daemonimage.BuildGateway
# cross-compiles for linux/arm64) and verbs.json (the gateway's policy), so this
# file copies what it runs and builds nothing.
FROM ubuntu:24.04

# ca-certificates is what bd's HTTPS calls verify against; git is what bd runs
# for the repository operations a rig's commands need; tini is the init the
# entrypoint puts in front of the gateway, so it reaps the children the gateway
# leaves and forwards the container's signals. These three are the only things
# installed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git tini \
    && rm -rf /var/lib/apt/lists/*

# The real bd, copied from the build context. The gateway runs /usr/local/bin/bd,
# so the real bd takes that name: the tracker program is deferred and no shim
# sits in front of it, so bd is a link to bd.real (gt-gi5lhe).
COPY --chmod=0755 bd.real /usr/local/bin/bd.real
RUN ln -sf /usr/local/bin/bd.real /usr/local/bin/bd

# The gateway is the container's entrypoint. This file sets no flags for it.
COPY --chmod=0755 bdgw /usr/local/bin/bdgw

# The gateway's policy file, at the path the compose unit starts it with
# (`--verbs /etc/bdgw/verbs.json`). The image build stages it into the build
# context beside bdgw. The directory is made first: a COPY that creates it gives
# it the copied file's mode, so the non-root user could not traverse it.
RUN mkdir -p /etc/bdgw && chmod 0755 /etc/bdgw
COPY --chmod=0444 verbs.json /etc/bdgw/verbs.json

# The gateway swaps its workspace tree by renaming a directory beside the root,
# so the root's parent must be writable by the user the image runs. The store
# root is /var/lib/bdgw/ws, under /var/lib/bdgw, which this line owns.
RUN mkdir -p /var/lib/bdgw && chown 65532:65532 /var/lib/bdgw

# gt writes workspace redirects under /ws, and that path must keep resolving to
# the store's tree now that the root lives under /var/lib/bdgw.
RUN ln -s /var/lib/bdgw/ws /ws

# A numeric non-root user, so the image does not depend on a name the base may
# not define.
USER 65532:65532

# tini is PID 1: it runs the gateway and reaps the children it leaves.
ENTRYPOINT ["tini", "--", "/usr/local/bin/bdgw", "serve"]
