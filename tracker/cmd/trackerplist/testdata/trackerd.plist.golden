<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.gastown.trackerd</string>
		<key>ProgramArguments</key>
		<array>
			<string>/Users/fixture/.local/bin/trackerd</string>
			<string>-listen</string>
			<string>127.0.0.1:7433</string>
		</array>
		<key>EnvironmentVariables</key>
		<dict>
			<key>TRACKER_DSN</key>
			<string>postgres://127.0.0.1:5433/tracker?sslmode=disable</string>
			<key>LC_ALL</key>
			<string>C</string>
			<key>LANG</key>
			<string>C</string>
		</dict>
		<key>KeepAlive</key>
		<true/>
		<key>ThrottleInterval</key>
		<integer>10</integer>
		<key>StandardOutPath</key>
		<string>/Users/fixture/gt/daemon/trackerd.log</string>
		<key>StandardErrorPath</key>
		<string>/Users/fixture/gt/daemon/trackerd.err.log</string>
	</dict>
</plist>
