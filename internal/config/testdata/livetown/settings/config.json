      ],
      "env": {
        "ANTHROPIC_BASE_URL": "http://127.0.0.1:8099",
        "ANTHROPIC_AUTH_TOKEN": "REDACTED",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "mtplx-qwen38-27b-optimized-speed",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "mtplx-qwen38-27b-optimized-speed",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "mtplx-qwen38-27b-optimized-speed",
        "CLAUDE_CODE_SUBAGENT_MODEL": "mtplx-qwen38-27b-optimized-speed",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_TOTAL_TOKENS_REMINDER": "off",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0",
        "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
        "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
        "API_TIMEOUT_MS": "1800000",
        "ANTHROPIC_MODEL": "mtplx-qwen38-27b-optimized-speed",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "65536",
        "CLAUDE_CONFIG_DIR": "/Users/operator/gt/.claude-town"
      }
    },
