  "role_agents": {
    "boot": "deepseek-flash",
    "crew": "claude-opus",
    "deacon": "deepseek-flash",
    "dog": "deepseek-flash",
    "polecat": "deepseek-flash",
    "refinery": "deepseek-flash-refinery",
    "witness": "deepseek-flash-patrol",
    "mayor": "claude-sonnet"
  },
  "role_effort": {
    "deacon": "medium",
    "mayor": "medium",
    "witness": "medium"
  },
  "operational": {
    "container_gate": {
      "slots": 4,
      "reserved_for_gate": 2
    }
  },
  "polecat_pool": {
    "local_agent": "local-coder-polecat",
    "max_local": 0,
    "idle_fill": true,
    "min_spawn_gap": "4m",
    "agent": "deepseek-flash",
    "max_seats": 1
  }
