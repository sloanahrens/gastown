{
  "type": "town-settings",
  "version": 1,
  "default_agent": "claude",
  "agents": {
    "claude-fable": {
      "provider": "claude",
      "command": "claude",
      "args": [
        "--dangerously-skip-permissions",
        "--model",
        "fable"
      ],
      "env": {
        "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0"
      }
    },
    "claude-haiku": {
      "provider": "claude",
      "command": "claude",
