    namespace: forgejo
    labels:
        app.kubernetes.io/managed-by: gt
        app.kubernetes.io/name: daemon
roleRef:
    apiGroup: rbac.authorization.k8s.io
    kind: Role
    name: gt-ci-cache-trim
subjects:
    - kind: ServiceAccount
      name: daemon
      namespace: gt
=== 11-clusterrolebinding-daemon-gt-sweep-reader.yaml ===
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
    name: daemon-gt-sweep-reader
    labels:
        app.kubernetes.io/managed-by: gt
        app.kubernetes.io/name: daemon
roleRef:
    apiGroup: rbac.authorization.k8s.io
    kind: ClusterRole
    name: gt-sweep-reader
subjects:
    - kind: ServiceAccount
      name: daemon
      namespace: gt
