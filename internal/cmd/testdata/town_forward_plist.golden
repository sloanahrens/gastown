<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gastown.forward-dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>pod=$(&quot;$1&quot; --context=&quot;$2&quot; --namespace=&quot;$3&quot; get pods -l &quot;app.kubernetes.io/name=$4&quot; --field-selector=status.phase=Running -o name | head -n 1)
[ -n &quot;$pod&quot; ] || { echo &quot;no Running pod for app.kubernetes.io/name=$4&quot; &gt;&amp;2; exit 1; }
&quot;$1&quot; --context=&quot;$2&quot; --namespace=&quot;$3&quot; port-forward --address=&quot;$5&quot; &quot;$pod&quot; &quot;$6&quot;:&quot;$6&quot; &amp;
p=$!
{ &quot;$1&quot; --context=&quot;$2&quot; --namespace=&quot;$3&quot; wait --for=delete &quot;$pod&quot; --timeout=8760h; kill &quot;$p&quot;; } &amp;
wait &quot;$p&quot;
exit 1</string>
		<string>sh</string>
		<string>/opt/homebrew/bin/kubectl</string>
		<string>colima-gt-control</string>
		<string>gt</string>
		<string>dashboard</string>
		<string>127.0.0.1</string>
		<string>8787</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/operator/gt/daemon/forward-dashboard.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/operator/gt/daemon/forward-dashboard.err.log</string>
</dict>
</plist>
