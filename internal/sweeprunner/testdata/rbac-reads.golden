# Every kubectl read the Kubernetes backend renders for a sweep run, one line per
# distinct call as `<verb> <resource> <scope>`: scope is cluster for -A, namespace
# for the sweep's own namespace gt-sweeps, and a namespace name for any other
# namespace. cp copies through pods/exec, as kubectl does. raw is a `kubectl get
# --raw`: one GET with no list, so it needs get and nothing more.
# TestSweepRBACGoldenMatchesTheRenderedPlan derives the plan's lines from the plan;
# the reads the daemon makes outside the plan are the sweepDaemonReads lines, which
# TestSweepRBACCoversEveryRead holds to deploy/k8s/sweep-rbac.yaml.
apply jobs namespace
apply persistentvolumeclaims namespace
apply pods namespace
create pods namespace
cp pods/exec namespace
delete jobs namespace
delete persistentvolumeclaims namespace
delete pods namespace
exec pods/exec forgejo
exec pods/exec namespace
get jobs namespace
get nodes cluster
get pods cluster
get pods forgejo
get priorityclasses cluster
raw nodes/proxy cluster
wait pods namespace
